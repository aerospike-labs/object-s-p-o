# Settings for the queryapi systemd service. Edit, then:
#   sudo systemctl restart queryapi
# Run /usr/local/bin/queryapi -h for every flag.

QUERYAPI_ARGS="-hosts 127.0.0.1:3000 -namespace test -listen :8090"

# Security-enabled clusters: add -user <name> to QUERYAPI_ARGS and set
# AEROSPIKE_PASSWORD=
